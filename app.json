{
  "expo": {
    "name": "Athena",
    "slug": "athena-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/athena-icon.png",
    "scheme": "athena",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/athena-splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sagittaerys.athena"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F5F2"
      },
      "package": "com.sagittaerys.athena"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/athena-splash-screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
